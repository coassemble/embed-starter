# Paste the whole key from Developer > API keys. Do not add "Bearer".
COASSEMBLE_KEY=

# Reuse this learner while testing. Replace it with your authenticated user's ID in your app.
COASSEMBLE_IDENTIFIER=test-anna

# Optional: override only when testing another Coassemble environment.
